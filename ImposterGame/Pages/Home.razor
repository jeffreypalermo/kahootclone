@page "/"
@inject NavigationManager Navigation

<PageTitle>Kahoot Clone - Game Selection</PageTitle>

<div class="game-container">
    <div class="setup-screen">
        <h1 class="game-title">🎮 Kahoot Clone</h1>
        <p class="game-subtitle">Choose your game mode!</p>

        <div class="game-selection">
            <div class="game-option">
                <h2>🧠 Quiz Game</h2>
                <p>Test your knowledge with multiple-choice questions. Earn points for speed and accuracy!</p>
                <button @onclick="@(() => Navigation.NavigateTo("/quiz"))" class="btn btn-start">Play Quiz</button>
            </div>

            <div class="game-option">
                <h2>🎭 Imposter Game</h2>
                <p>One player is the imposter. Find them before it's too late!</p>
                <button @onclick="@(() => Navigation.NavigateTo("/imposter"))" class="btn btn-start">Play Imposter</button>
            </div>
        </div>
    </div>
</div>

